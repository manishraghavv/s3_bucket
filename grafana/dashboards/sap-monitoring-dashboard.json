      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 40 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_al08_background_users", "legendFormat": "Background", "refId": "A" }],
