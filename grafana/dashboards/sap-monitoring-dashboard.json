      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "orientation": "auto", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "topk(10, sap_al08_client_count)", "legendFormat": "Client {{client}}", "refId": "A" }],
      "fieldConfig": { "defaults": {} }
    },
    {
      "id": 16, "title": "Users by Transaction", "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
