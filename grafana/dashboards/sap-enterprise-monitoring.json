{
  "title": "SAP Enterprise Monitoring",
  "uid": "sap-enterprise-monitoring",
  "version": 1,
  "schemaVersion": 38,
  "tags": ["sap", "enterprise", "monitoring"],
  "timezone": "browser",
  "editable": true,
  "refresh": "60s",
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s","10s","30s","1m","5m","15m","30m","1h","2h","1d"],
    "time_options": ["5m","15m","1h","6h","12h","24h","2d","7d","30d"]
  },
  "panels": [
    {
      "id": 1, "title": "Exporter Health", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false
    },
    {
      "id": 2, "title": "Exporter Status", "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 0, "y": 1 },
      "description": "Up/Down status of the SAP Prometheus exporter",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "red", "value": 0 }, { "color": "green", "value": 1 }] },
          "color": { "mode": "thresholds" },
          "mappings": [{ "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Up", "color": "green" } } }]
        }
      },
      "targets": [{ "expr": "up{job=\"sap-exporter\"}", "legendFormat": "Status", "refId": "A" }]
    },
    {
      "id": 3, "title": "Exporter Uptime", "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 3, "y": 1 },
      "description": "How long the exporter has been running",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "none", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "decimals": 0, "color": { "mode": "none" } } },
      "targets": [{ "expr": "sap_exporter_uptime_seconds", "legendFormat": "Uptime", "refId": "A" }]
    },
    {
      "id": 4, "title": "Last Scrape Duration", "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 6, "y": 1 },
      "description": "Time taken for the last scrape cycle (S3 list + download + parse)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 15 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_exporter_scrape_duration_seconds", "legendFormat": "Duration", "refId": "A" }]
    },
    {
      "id": 5, "title": "JSON Files Processed", "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 9, "y": 1 },
      "description": "Number of S3 JSON files successfully parsed in last scrape",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_exporter_scrape_success_total", "legendFormat": "Files OK", "refId": "A" }]
    },
    {
      "id": 6, "title": "Parse Errors", "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 12, "y": 1 },
      "description": "Number of JSON files that failed to parse in last scrape",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_exporter_scrape_error_total", "legendFormat": "Errors", "refId": "A" }]
    },
    {
      "id": 7, "title": "T-Codes Found", "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 15, "y": 1 },
      "description": "Total distinct T-Codes found in S3 bucket",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_exporter_scrape_tcodes_total", "legendFormat": "T-Codes", "refId": "A" }]
    },
    {
      "id": 8, "title": "Active Metrics", "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 18, "y": 1 },
      "description": "Total Prometheus metrics generated from all T-Codes",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "red", "value": 0 }, { "color": "green", "value": 5 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_exporter_scrape_metrics_total", "legendFormat": "Metrics", "refId": "A" }]
    },
    {
      "id": 9, "title": "JSON Age", "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 21, "y": 1 },
      "description": "Age of the latest JSON file in S3 (should be < scrape interval)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 120 }, { "color": "red", "value": 300 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_exporter_json_age_seconds", "legendFormat": "Age", "refId": "A" }]
    },

    {
      "id": 10, "title": "AL08 — Logged-On Users", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 }, "collapsed": false
    },
    {
      "id": 11, "title": "Total Users", "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 5 },
      "description": "Unique logged-on users across all sessions",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_al08_logged_users", "legendFormat": "Users", "refId": "A" }]
    },
    {
      "id": 12, "title": "Total Sessions", "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 5 },
      "description": "Total active sessions including duplicates",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_al08_total_sessions", "legendFormat": "Sessions", "refId": "A" }]
    },
    {
      "id": 13, "title": "GUI Users", "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 5 },
      "description": "Users connected via SAP GUI (type A)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 100 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_al08_gui_users", "legendFormat": "GUI", "refId": "A" }]
    },
    {
      "id": 14, "title": "Background Users", "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 5 },
      "description": "Background processing users (type B)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 40 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_al08_background_users", "legendFormat": "Background", "refId": "A" }]
    },
    {
      "id": 15, "title": "RFC Users", "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 5 },
      "description": "RFC-connected users (type C)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 80 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_al08_rfc_users", "legendFormat": "RFC", "refId": "A" }]
    },
    {
      "id": 16, "title": "User Trend", "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "description": "Logged-on users over time by session type",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean","max","min"] }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineInterpolation": "smooth", "fillOpacity": 15, "pointSize": 2 } } },
      "targets": [
        { "expr": "sap_al08_gui_users", "legendFormat": "GUI Users", "refId": "A" },
        { "expr": "sap_al08_background_users", "legendFormat": "Background", "refId": "B" },
        { "expr": "sap_al08_rfc_users", "legendFormat": "RFC Users", "refId": "C" },
        { "expr": "sap_al08_total_sessions", "legendFormat": "Total Sessions", "refId": "D" }
      ]
    },
    {
      "id": 17, "title": "Users by Client", "type": "barchart",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 8 },
      "description": "Active sessions grouped by SAP client",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "orientation": "auto", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "topk(10, sap_al08_client_count)", "legendFormat": "Client {{client}}", "refId": "A" }],
      "fieldConfig": { "defaults": {} }
    },
    {
      "id": 18, "title": "Users by Transaction", "type": "barchart",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 8 },
      "description": "Active sessions grouped by T-Code/transaction",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "orientation": "auto", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "topk(10, sap_al08_tcode_count)", "legendFormat": "{{tcode}}", "refId": "A" }],
      "fieldConfig": { "defaults": {} }
    },
    {
      "id": 19, "title": "Users by Terminal", "type": "barchart",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 15 },
      "description": "Active sessions grouped by terminal name",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "orientation": "auto", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "topk(10, sap_al08_terminal_count)", "legendFormat": "{{terminal}}", "refId": "A" }],
      "fieldConfig": { "defaults": {} }
    },
    {
      "id": 20, "title": "Users by Host", "type": "barchart",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 15 },
      "description": "Active sessions grouped by application server host",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "orientation": "auto", "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "topk(10, sap_al08_host_count)", "legendFormat": "{{host}}", "refId": "A" }],
      "fieldConfig": { "defaults": {} }
    },
    {
      "id": 21, "title": "Logged User Table", "type": "table",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 15 },
      "description": "Users with their session counts per terminal",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "footer": { "show": false }, "frameIndex": 0, "showTypeIcons": false },
      "transformations": [
        { "id": "seriesToRows", "options": {} }
      ],
      "targets": [{ "expr": "topk(20, sap_al08_user_count)", "legendFormat": "{{user}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "custom": { "align": "left", "displayMode": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value #A" }, "properties": [{ "id": "displayName", "value": "Sessions" }] },
          { "matcher": { "id": "byName", "options": "user" }, "properties": [{ "id": "displayName", "value": "User ID" }] }
        ]
      }
    },

    {
      "id": 22, "title": "SM12 — Lock Monitoring", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "collapsed": false
    },
    {
      "id": 23, "title": "Total Locks", "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 23 },
      "description": "Total number of lock entries in the system",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_sm12_total_locks", "legendFormat": "Locks", "refId": "A" }]
    },
    {
      "id": 24, "title": "Exclusive Locks", "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 23 },
      "description": "Locks in exclusive mode (E/X) — blocks other users from accessing the record",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_sm12_exclusive_locks", "legendFormat": "Exclusive", "refId": "A" }]
    },
    {
      "id": 25, "title": "Shared Locks", "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 23 },
      "description": "Locks in shared mode (S) — allows concurrent read access",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_sm12_shared_locks", "legendFormat": "Shared", "refId": "A" }]
    },
    {
      "id": 26, "title": "Locked Tables", "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 23 },
      "description": "Number of unique database tables with active locks",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_sm12_locked_tables", "legendFormat": "Tables", "refId": "A" }]
    },
    {
      "id": 27, "title": "Unique Users", "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 23 },
      "description": "Unique users holding locks",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "sap_sm12_unique_users", "legendFormat": "Users", "refId": "A" }]
    },
    {
      "id": 28, "title": "Lock Trend", "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 26 },
      "description": "Lock counts over time by lock mode",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineInterpolation": "smooth", "fillOpacity": 15 } } },
      "targets": [
        { "expr": "sap_sm12_exclusive_locks", "legendFormat": "Exclusive", "refId": "A" },
        { "expr": "sap_sm12_shared_locks", "legendFormat": "Shared", "refId": "B" },
        { "expr": "sap_sm12_total_locks", "legendFormat": "Total", "refId": "C" }
      ]
    },
    {
      "id": 29, "title": "Locks by Table", "type": "barchart",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 26 },
      "description": "Distribution of locks across database tables",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "orientation": "auto", "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "expr": "topk(10, sap_sm12_table_count)", "legendFormat": "{{table}}", "refId": "A" }],
      "fieldConfig": { "defaults": {} }
    },
    {
      "id": 30, "title": "Lock Mode Distribution", "type": "piechart",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 26 },
      "description": "Breakdown of locks by lock mode",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "pieType": "pie", "legend": { "displayMode": "list", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sap_sm12_lock_mode_count", "legendFormat": "{{lock_mode}}", "refId": "A" }],
      "fieldConfig": { "defaults": {} }
    },
    {
      "id": 31, "title": "Lock Detail Table", "type": "table",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 33 },
      "description": "Lock counts by user and table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "footer": { "show": false }, "frameIndex": 0 },
      "transformations": [{ "id": "seriesToRows", "options": {} }],
      "targets": [{ "expr": "topk(20, sap_sm12_user_count)", "legendFormat": "{{user}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value #A" }, "properties": [{ "id": "displayName", "value": "Locks Held" }] }
        ]
      }
    },
    {
      "id": 32, "title": "Locks by Client", "type": "barchart",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 33 },
      "description": "Lock distribution across SAP clients",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "orientation": "auto", "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{ "expr": "sap_sm12_client_count", "legendFormat": "{{client}}", "refId": "A" }],
      "fieldConfig": { "defaults": {} }
    },

    {
      "id": 33, "title": "SM50 — Work Process Monitoring", "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }, "collapsed": false
    },
    {
      "id": 34, "title": "Total WPs", "type": "stat",
      "gridPos": { "h": 3, "w": 3, "x": 0, "y": 41 },
      "description": "Total number of work processes configured",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
