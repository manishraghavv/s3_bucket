      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "custom": { "lineInterpolation": "smooth", "fillOpacity": 10 }, "color": { "mode": "palette-classic" } } },
      "targets": [
        { "expr": "sap_al08_gui_users", "legendFormat": "GUI Users", "refId": "A" },
        { "expr": "sap_al08_background_users", "legendFormat": "Background", "refId": "B" },
        { "expr": "sap_al08_rfc_users", "legendFormat": "RFC Users", "refId": "C" },
        { "expr": "sap_al08_total_sessions", "legendFormat": "Total Sessions", "refId": "D" }
